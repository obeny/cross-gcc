+	retval = at32_qspi_wait_status(target, AT32_QSPI_REG(CMDSTS_OFFSET), 0, 1);
+	if(retval != ERROR_OK)
+	{
+		LOG_ERROR("Wait QSPI CMDSTS_OFFSET FLAG  Error");
