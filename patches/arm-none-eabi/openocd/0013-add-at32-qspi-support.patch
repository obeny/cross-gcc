+		.name = "qspi_mass_erase",
+		.handler = at32qspi_handle_mass_erase_command,
+		.mode = COMMAND_EXEC,
+		.usage = "bank_id",
+		.help = "mass erase qspi flash device.",
+	},
+	COMMAND_REGISTRATION_DONE
+};
+
+
